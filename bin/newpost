#!/usr/bin/env python3
"""newpost — turn a vault note into a Hugo post in content/posts/.

    newpost <uuid|filename|path>        create a Hugo DRAFT (vault untouched)
    newpost <src> --publish            create it live and retag the vault note
    newpost <src> --summary "..." --tags "a,b"    skip the prompts
    newpost <src> --date 2026-09-27T09:00:00Z     override the post date

Frontmatter mapping (vault -> Hugo):
    title:  -> title: (quoted)          date: -> now, or --date
    tags:   -> tags:, minus lifecycle   summary: -> prompted, no vault equivalent
Body: the ```text fence poems are wrapped in is stripped, as is the leading H1.

With --publish the vault note is retagged draft -> published, the live URL is
appended to it, and its link moves from Drafts to Published in moc_create.md.
Stdlib only.
"""
import argparse, datetime, pathlib, re, subprocess, sys

VAULT = pathlib.Path.home() / "notes"
BLOG = pathlib.Path(__file__).resolve().parent.parent
POSTS = BLOG / "content" / "posts"
TEMPLATE = BLOG / "templates" / "post.md"
BASEURL = "https://phr3d.net"
LIFECYCLE = {"atomic", "literature", "project", "fleeting", "draft", "published"}


def die(msg):
    sys.exit(f"newpost: {msg}")


def find_source(arg):
    p = pathlib.Path(arg)
    if p.is_file():
        return p
    for cand in (VAULT / arg, VAULT / f"{arg}.md",
                 VAULT / "drafts" / arg, VAULT / "drafts" / f"{arg}.md"):
        if cand.is_file():
            return cand
    if re.fullmatch(r"\d{12}", arg):
        hits = sorted(VAULT.glob(f"{arg}*.md")) + sorted(VAULT.glob(f"drafts/{arg}*.md"))
        if hits:
            return hits[0]
    matches = [q for q in VAULT.glob("drafts/*.md") if arg.lower() in q.stem.lower()]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        die("ambiguous source:\n  " + "\n  ".join(q.name for q in matches))
    die(f"no vault note matching {arg!r}")


def split_fm(text):
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        die("source note has no frontmatter")
    return m.group(1), text[m.end():]


def field(fm, key):
    m = re.search(rf"^{key}:\s*(.*)$", fm, re.M)
    return m.group(1).strip().strip('"').strip("'") if m else ""


def vault_tags(fm):
    raw = field(fm, "tags")
    items = [t.strip().strip('"').strip("'") for t in raw.strip("[]").split(",")]
    return [t for t in items if t and t not in LIFECYCLE]


def clean_body(body):
    body = body.strip("\n")
    body = re.sub(r"^#\s+.*\n+", "", body, count=1)          # drop the H1
    m = re.match(r"^```(?:text)?\s*\n(.*?)\n\s*```\s*$", body.strip(), re.S)
    if m:                                                     # unwrap poem fence
        body = m.group(1)
    body = re.sub(r"\n{3,}", "\n\n", body.strip("\n"))
    return body


def slugify(title):
    s = re.sub(r"[^\w\s-]", "", title.lower())
    return re.sub(r"[\s_]+", "-", s).strip("-")


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("source")
    ap.add_argument("--summary", default=None)
    ap.add_argument("--tags", default=None)
    ap.add_argument("--date", default=None)
    ap.add_argument("--slug", default=None)
    ap.add_argument("--publish", action="store_true",
                    help="draft: false, and retag the vault note published")
    ap.add_argument("--force", action="store_true", help="overwrite an existing post")
    a = ap.parse_args()

    src = find_source(a.source)
    fm, body = split_fm(src.read_text(encoding="utf-8"))
    title = field(fm, "title") or src.stem.replace("_", " ")
    tags = vault_tags(fm)

    summary = a.summary
    if summary is None:
        summary = input(f'Summary for "{title}": ').strip()
    if not summary:
        die("a summary is required (the theme shows it on the card and sidebar)")

    if a.tags is not None:
        tags = [t.strip() for t in a.tags.split(",") if t.strip()]
    else:
        extra = input(f"Tags [{', '.join(tags) or 'none'}]: ").strip()
        if extra:
            tags = [t.strip() for t in extra.split(",") if t.strip()]

    date = a.date or datetime.datetime.now(
        datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    slug = a.slug or slugify(title)
    dest = POSTS / f"{slug}.md"
    if dest.exists() and not a.force:
        die(f"{dest.relative_to(BLOG)} already exists (use --force)")

    out = TEMPLATE.read_text(encoding="utf-8")
    for k, v in {
        "{{TITLE}}": title.replace('"', r'\"'),
        "{{DATE}}": date,
        "{{DRAFT}}": "false" if a.publish else "true",
        "{{SUMMARY}}": summary.replace('"', r'\"'),
        "{{TAGS}}": ", ".join(tags),
        "{{BODY}}": clean_body(body),
    }.items():
        out = out.replace(k, v)
    dest.write_text(out.rstrip("\n") + "\n", encoding="utf-8")

    url = f"{BASEURL}/posts/{slug}/"
    print(f"  wrote   {dest.relative_to(BLOG)}")
    print(f"  source  {src.relative_to(VAULT)}")
    print(f"  url     {url}" + ("" if a.publish else "   (draft — not live yet)"))

    if a.publish:
        t = src.read_text(encoding="utf-8")
        t2 = re.sub(r"^(tags:\s*\[.*?)\bdraft\b(.*?\])\s*$",
                    r"\1published\2", t, count=1, flags=re.M)
        if t2 == t:
            already = "published" in field(split_fm(t)[0], "tags")
            print("  note    already published" if already
                  else "  note    no `draft` tag found; tags left alone")
        t = t2
        if url not in t:
            t = t.rstrip("\n") + f"\n\nPublished: {url}\n"
        src.write_text(t, encoding="utf-8")
        print(f"  retagged {src.name}: draft -> published")

        moc = VAULT / "moc_create.md"
        if moc.exists():
            m = moc.read_text(encoding="utf-8")
            line_re = re.compile(rf"^- \[\[{re.escape(src.stem)}\]\].*$\n?", re.M)
            hit = line_re.search(m)
            if hit:
                entry = hit.group(0)
                m = line_re.sub("", m)
                m = re.sub(r"(^## Published[^\n]*\n\n)", r"\1" + entry, m,
                           count=1, flags=re.M)
                moc.write_text(m, encoding="utf-8")
                print("  moc_create: Drafts -> Published")

    print(f"\n  preview: cd {BLOG} && nix develop -c hugo server -D")
    print(f"  publish: newpost {a.source} --publish   (then commit and push)")


if __name__ == "__main__":
    main()
